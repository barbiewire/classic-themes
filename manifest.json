{
  "manifest_version": 3,
  "name": "Classic ROBLOX",
  "version": "1.7.0",
  "description": "Old roblox.com skins - pick 2008-2010, 2011-2012, 2014 or 2015-2016. Optional archived user ads.",
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_title": "Classic ROBLOX",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*",
        "https://web.roblox.com/*"
      ],
      "css": [
        "classic.css"
      ],
      "js": [
        "classic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/*"
      ],
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*",
        "https://web.roblox.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "host_permissions": [
    "https://archive.org/*",
    "https://*.archive.org/*",
    "https://raw.githubusercontent.com/*"
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Turn the skin on or off"
    }
  }
}
