{
  "manifest_version": 3,
  "name": "Classic ROBLOX",
  "version": "1.4.1",
  "description": "Old roblox.com skins - pick 2008-2010, 2011-2012, 2014 or 2015-2016.",
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_title": "Classic ROBLOX",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*",
        "https://web.roblox.com/*"
      ],
      "css": [
        "classic.css"
      ],
      "js": [
        "classic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/*"
      ],
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*",
        "https://web.roblox.com/*"
      ]
    }
  ]
}
